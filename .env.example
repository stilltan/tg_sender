# Telegram Bot Settings
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (the bot will recognize you as super admin)
# Get it from @userinfobot on Telegram
SUPER_ADMIN_ID=your_telegram_id_here

# Optional: Admin group ID for notifications
ADMIN_GROUP_ID=

# Optional: base URL for Telegram API proxy (for blocked regions)
# BOT_API_BASE_URL=https://your-proxy.workers.dev/bot

# --- Web dashboard ---
# Password for the first 'admin' user (created automatically on first start)
# Change it after setup! Default fallback: admin123
TG_SENDER_ADMIN_PASSWORD=change_me_please

# --- Telethon API (accounts) ---
# Your own API credentials from https://my.telegram.org (recommended)
# Defaults are public demo values and may be rate-limited
TG_SENDER_API_ID=
TG_SENDER_API_HASH=

# Database path (optional, default: data/sender.db)
# TG_SENDER_DB_PATH=data/sender.db
